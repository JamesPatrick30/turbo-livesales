{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "dependsOn": ["^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "prisma/schema.prisma"],
      "outputs": ["generated/prisma/**"]
    },
    "db:migrate": {
      "dependsOn": ["^db:migrate"],
      "inputs": ["$TURBO_DEFAULT$", "prisma/migrations/**"],
      "outputs": []
    },
    "db:deploy": {
      "dependsOn": ["^db:deploy"],
      "inputs": ["$TURBO_DEFAULT$", "prisma/migrations/**"],
      "outputs": []
    },
    "db:studio": {
      "dependsOn": ["^db:studio"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    }
  }
}
