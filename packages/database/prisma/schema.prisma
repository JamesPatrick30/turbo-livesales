// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  role      UserRole
  email     String   @unique
  password  String
  name      String?
  adminOwnerId String? 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]
  sales Sales[]
  cashier Sales[] @relation("CashierSales")
}

enum UserRole {
  ADMIN
  COOK
  CASHIER
}

model MenuItem {
  id          String   @id @default(uuid())

  adminOwnerId     String
  user        User     @relation(fields: [adminOwnerId], references: [id])

  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  category    String
  status      MenuItemStatus @default(AVAILABLE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales SaleItem[]
}

enum MenuItemStatus {
  AVAILABLE
  UNAVAILABLE
}

model Sales {
  id          String   @id @default(uuid())
  receiptNo     String        @unique
  
  adminOwnerId String
  cashierId    String

  cashier     User     @relation("CashierSales",fields: [cashierId], references: [id])
  user        User     @relation(fields: [adminOwnerId], references: [id])

  items       SaleItem[]

  paymentMethod PaymentMethod @default(CASH)

  // PENDING, PREPARING, READY, SERVED, VOID
  orderstatus OrderStatus @default(PENDING)

  // DINE_IN, TAKEAWAY, DELIVERY
  Ordertype    OrderType

  total       Decimal @db.Decimal(10, 2)

  readyAt     DateTime?
  createdAt   DateTime @default(now())
}

enum PaymentMethod {
  CASH
  CARD
  GOOGLE_PAY
  GCASH
  MAYA
  GOTYME
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  VOID
}

model SaleItem{
  id          String   @id @default(uuid())
  salesId     String
  sales       Sales    @relation(fields: [salesId], references: [id])

  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])

  // item snapshot
  name        String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  category    String

  lineTotal   Decimal @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([salesId])
  @@index([menuItemId])
  @@index([category])
}